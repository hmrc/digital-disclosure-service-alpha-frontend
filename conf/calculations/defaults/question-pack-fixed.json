{
  "id": "rates-only-fixed",
  "title": "Fixed_disclosure_questions_Option_1",
  "questions": [
    {
      "id": "taxYears",
      "type": "checkboxes",
      "title": "Which_tax_years_does_this_disclosure_relate_to",
      "hint": "Select_all_that_apply_Options_come_from_the_rate_catalogue_years",
      "required": true,
      "perTaxYear": false,
      "optionsFromRates": true
    },
    {
      "id": "ageBand",
      "type": "singleChoice",
      "title": "What_was_your_age_band_for_the_tax_years_you_are_disclosing",
      "options": [
        {
          "value": "under65",
          "label": "Aged_16_to_64"
        },
        {
          "value": "65to74",
          "label": "Aged_65_to_74"
        },
        {
          "value": "75plus",
          "label": "Aged_75_or_over"
        }
      ],
      "required": true,
      "perTaxYear": false,
      "optionsFromRates": false
    },
    {
      "id": "marriedOrCivilPartnership",
