      "options": [
        { "value": "rightAway", "label": "Right_away_I_acted_promptly" },
        { "value": "shortDelay", "label": "After_a_short_delay" },
        { "value": "significantTime", "label": "It_took_a_significant_time" }
      ],
      "required": true,
      "perTaxYear": true,
      "optionsFromRates": false
