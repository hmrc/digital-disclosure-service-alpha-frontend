{
  "id": "income-tax-design-focus-feel",
  "version": "1.0.0",
  "description": "The same estimate as calculation-spec.json 1.5.0, written as named FEEL steps. Each step is one FEEL expression that reads answers.<question id>, rates.<rate key>, earlier steps by id, and groups.<group>. Penalty: an onshore, prompted failure to notify, where telling (up to 30%), helping (up to 40%) and giving (up to 30%) narrow the 30% to 20% range. A reasonable excuse means no penalty.",
  "steps": [
    { "id": "employmentIncome", "label": "Employment_income", "group": "income",
      "feel": "max(0, answers.employmentIncome)" },
    { "id": "selfEmploymentProfit", "label": "Self_employment_profit", "group": "income",
      "feel": "max(0, answers.selfEmploymentTurnover - answers.selfEmploymentExpenses - answers.selfEmploymentTradingAllowance)" },
    { "id": "ukPropertyProfit", "label": "UK_property_profit", "group": "income",
      "feel": "max(0, answers.propertyIncome - answers.propertyExpenses - answers.propertyAllowance)" },
    { "id": "pensionIncome", "label": "Pension_income", "group": "income",
      "feel": "max(0, answers.pensionIncome)" },
    { "id": "employmentBenefits", "label": "Benefits_from_employment", "group": "income",
      "feel": "max(0, answers.employmentBenefits)" },
    { "id": "trustsEstates", "label": "Income_from_a_trust", "group": "income",
      "feel": "max(0, answers.trustsEstates)" },
    { "id": "chargeableEventGains", "label": "Chargeable_event_gains", "group": "income",
      "feel": "max(0, answers.chargeableEventGains)" },
    { "id": "partnershipIncome", "label": "Partnership_income", "group": "income",
      "feel": "max(0, answers.partnershipIncome)" },
    { "id": "remittanceBasisCharge", "label": "Remittance_basis_charge", "group": "income",
      "feel": "max(0, answers.remittanceBasisCharge)" },
    { "id": "pensionCharges", "label": "Pension_charges", "group": "income",
      "feel": "max(0, answers.pensionCharges)" },
    { "id": "bankInterest", "label": "Income_from_UK_savings", "group": "income",
      "feel": "max(0, answers.bankInterest)" },
    { "id": "dividends", "label": "Dividends_income", "group": "income",
      "feel": "max(0, answers.dividends)" },
    { "id": "foreignIncome", "label": "Foreign_income_or_dividends", "group": "income",
      "feel": "max(0, answers.foreignIncome)" },
    { "id": "otherUkIncome", "label": "Other_UK_income", "group": "income",
      "feel": "max(0, answers.otherUkIncome)" },
    { "id": "totalIncome", "label": "Total_income",
      "feel": "sum(groups.income)" },
    { "id": "personalAllowance", "label": "Personal_allowance",
      "feel": "max(0, rates.personalAllowance - floor(max(0, totalIncome - rates.taperThreshold) / 2))" },
    { "id": "blindPersonsAllowance", "label": "Blind_Persons_Allowance",
      "feel": "if answers.blindPersonEligible = \"yes\" then rates.blindPersonsAllowance else 0" },
    { "id": "taxableIncome", "label": "Taxable_income",
      "feel": "max(0, totalIncome - personalAllowance - blindPersonsAllowance)" },
    { "id": "basicRateTax", "label": "calculations.feel.step.basicRateTax",
      "feel": "min(taxableIncome, rates.basicRateBand) * rates.basicRate" },
    { "id": "higherRateTax", "label": "calculations.feel.step.higherRateTax",
      "feel": "max(0, taxableIncome - rates.basicRateBand) * rates.higherRate" },
    { "id": "taxBeforePayments", "label": "Estimated_income_tax_before_tax_already_paid",
      "feel": "round half up(basicRateTax + higherRateTax, 2)" },
    { "id": "taxAlreadyPaid", "label": "Tax_already_paid",
      "feel": "answers.taxAlreadyPaid + answers.employmentTaxDeducted + answers.bankInterestTaxDeducted + answers.pensionTaxDeducted" },
    { "id": "taxDue", "label": "Estimated_income_tax",
      "feel": "round half up(max(0, taxBeforePayments - taxAlreadyPaid), 2)" },

    { "id": "penaltyAnswered", "label": "calculations.feel.step.penaltyAnswered", "part": "penalty", "format": "yesNo",
      "feel": "answers.penaltyBehaviour != null" },
    { "id": "penaltyApplies", "label": "calculations.feel.step.penaltyApplies", "part": "penalty", "format": "yesNo",
      "feel": "answers.penaltyBehaviour = \"noExcuse\"" },
    { "id": "timingScore", "label": "Timing", "part": "penalty", "format": "number",
      "feel": "if answers.tellingTiming = \"withinDeadline\" then 1 else 0" },
    { "id": "natureScore", "label": "Nature", "part": "penalty", "format": "number",
      "feel": "if list contains([\"honestError\", \"misunderstanding\", \"incorrectAdvice\"], answers.tellingNature) then 1 else 0" },
    { "id": "extentScore", "label": "Extent", "part": "penalty", "format": "number",
      "feel": "if list contains([\"everything\", \"complexRemembered\"], answers.tellingExtent) then 1 else 0" },
    { "id": "helpingScore", "label": "calculations.feel.step.helpingScore", "part": "penalty", "format": "number",
      "feel": "if answers.helpingSpeed = \"rightAway\" then 1 else if answers.helpingSpeed = \"shortDelay\" then 0.5 else 0" },
    { "id": "tellingMaximum", "label": "calculations.feel.step.tellingMaximum", "part": "penalty", "format": "percentage",
      "feel": "0.30" },
    { "id": "helpingMaximum", "label": "calculations.feel.step.helpingMaximum", "part": "penalty", "format": "percentage",
      "feel": "0.40" },
    { "id": "givingMaximum", "label": "calculations.feel.step.givingMaximum", "part": "penalty", "format": "percentage",
      "feel": "0.30" },
    { "id": "telling", "label": "Telling", "part": "penalty", "format": "percentage",
      "feel": "mean(timingScore, natureScore, extentScore) * tellingMaximum" },
    { "id": "helping", "label": "Helping", "part": "penalty", "format": "percentage",
      "feel": "helpingScore * helpingMaximum" },
    { "id": "giving", "label": "Giving", "part": "penalty", "format": "percentage",
      "feel": "givingMaximum" },
    { "id": "quality", "label": "Quality_of_disclosure", "part": "penalty", "format": "percentage",
      "feel": "telling + helping + giving" },
    { "id": "upperRange", "label": "calculations.feel.step.upperRange", "part": "penalty", "format": "percentage",
      "feel": "0.30" },
    { "id": "lowerRange", "label": "calculations.feel.step.lowerRange", "part": "penalty", "format": "percentage",
      "feel": "0.20" },
    { "id": "penaltyRate", "label": "Penalty_percentage_rate", "part": "penalty", "format": "percentage",
      "feel": "upperRange - (upperRange - lowerRange) * quality" },
    { "id": "penalty", "label": "Penalty", "part": "penalty",
      "feel": "if penaltyApplies then round half up(taxDue * penaltyRate, 2) else 0" }
  ],
  "outputs": {
    "totalIncome": "totalIncome",
    "taxableIncome": "taxableIncome",
    "taxDue": "taxDue",
    "allowances": ["personalAllowance", "blindPersonsAllowance"],
    "penalty": "penalty",
    "penaltyAnswered": "penaltyAnswered"
  }
}
