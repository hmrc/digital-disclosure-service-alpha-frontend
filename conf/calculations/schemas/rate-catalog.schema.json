{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hmrc.gov.uk/dds-alpha/calculations/rate-catalog.schema.json",
  "title": "DDS calculations prototype rate catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "years"],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "years": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ratePack" }
    }
  },
  "$defs": {
    "ratePack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taxYear",
        "version",
        "personalAllowance",
        "taperThreshold",
        "blindPersonsAllowance",
        "basicRateBand",
        "basicRate",
        "higherRate"
      ],
      "properties": {
        "taxYear": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$",
          "description": "Tax year label, e.g. 2017-18"
        },
        "version": { "type": "string", "minLength": 1 },
        "personalAllowance": { "type": "number", "minimum": 0 },
        "taperThreshold": { "type": "number", "minimum": 0 },
        "blindPersonsAllowance": { "type": "number", "minimum": 0 },
        "basicRateBand": { "type": "number", "minimum": 0 },
        "basicRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "higherRate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
