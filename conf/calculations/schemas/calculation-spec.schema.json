{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hmrc.gov.uk/dds-alpha/calculations/calculation-spec.schema.json",
  "title": "DDS calculations prototype calculation spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "incomeComponents",
    "allowances",
    "tax"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "incomeComponents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/incomeComponent"
      }
    },
    "allowances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/allowance"
      }
    },
    "taxPaidFields": {
      "description": "Answer fields summed as tax already paid or deducted at source, then subtracted from the tax estimate.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tax": {
      "$ref": "#/$defs/taxRules"
    },
    "penalty": {
      "description": "Quality-of-disclosure penalty. Percentage fields are percentage points (30 means 30%). Omit to estimate tax only.",
      "$ref": "#/$defs/penaltyRules"
    }
  },
  "$defs": {
    "messageKey": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$"
    },
    "rateKey": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "description": "The key of a rate declared in the rate catalogue's `rates`, e.g. personalAllowance"
    },
    "showIf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "equals": {
          "type": "string"
        },
        "contains": {
          "type": "string"
        },
        "notEquals": {
          "type": "string"
        }
      }
    },
    "incomeComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "$ref": "#/$defs/messageKey"
        },
        "kind": {
          "type": "string",
          "enum": [
            "amount",
            "net"
          ]
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "grossField": {
          "type": "string",
          "minLength": 1
        },
        "deductField": {
          "type": "string",
          "minLength": 1
        },
        "altDeductField": {
          "type": "string",
          "minLength": 1
        },
        "floorAtZero": {
          "type": "boolean"
        }
      }
    },
    "taper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thresholdRateKey",
        "reduceBy",
        "forEvery"
      ],
      "properties": {
        "thresholdRateKey": {
          "$ref": "#/$defs/rateKey"
        },
        "reduceBy": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "forEvery": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "allowance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind",
        "rateKey"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "$ref": "#/$defs/messageKey"
        },
        "kind": {
          "type": "string",
          "enum": [
            "personalAllowance",
            "conditionalAmount"
          ]
        },
        "rateKey": {
          "$ref": "#/$defs/rateKey"
        },
        "taper": {
          "$ref": "#/$defs/taper"
        },
        "when": {
          "$ref": "#/$defs/showIf"
        }
      }
    },
    "taxBand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rateKey",
        "label"
      ],
      "properties": {
        "rateKey": {
          "$ref": "#/$defs/rateKey"
        },
        "label": {
          "$ref": "#/$defs/messageKey"
        },
        "upToRateKey": {
          "$ref": "#/$defs/rateKey"
        }
      }
    },
    "taxRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bands"
      ],
      "properties": {
        "bands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/taxBand"
          }
        },
        "scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "rounding": {
          "type": "string",
          "enum": [
            "halfUp",
            "up",
            "down",
            "floor",
            "ceiling"
          ]
        }
      }
    },
    "penaltyScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "score"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "score": {
          "description": "Fraction of this part or slice. 1 is a full reduction and 0 is none.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "tellingPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "question", "scores"],
      "properties": {
        "id": { "$ref": "#/$defs/rateKey" },
        "label": { "$ref": "#/$defs/messageKey" },
        "question": { "$ref": "#/$defs/rateKey" },
        "scores": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/penaltyScore" }
        }
      }
    },
    "tellingReduction": {
      "type": "object",
      "additionalProperties": false,
      "description": "Telling is the average of its parts, multiplied by maximum.",
      "required": ["maximum", "parts"],
      "properties": {
        "maximum": { "type": "number", "minimum": 0, "maximum": 100 },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tellingPart" }
        }
      }
    },
    "disclosureSlice": {
      "type": "object",
      "additionalProperties": false,
      "description": "Helping or giving. With question, use the matching score. With no question, score is a fixed fraction of maximum.",
      "required": ["label", "maximum"],
      "properties": {
        "label": { "$ref": "#/$defs/messageKey" },
        "maximum": { "type": "number", "minimum": 0, "maximum": 100 },
        "question": { "$ref": "#/$defs/rateKey" },
        "scores": {
          "type": "array",
          "items": { "$ref": "#/$defs/penaltyScore" }
        },
        "score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "penaltyRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upperRange", "lowerRange", "excuseQuestion", "excuseValue", "telling", "helping", "giving"],
      "properties": {
        "upperRange": { "description": "Top of the penalty range, in percentage points.", "type": "number", "minimum": 0, "maximum": 100 },
        "lowerRange": { "description": "Bottom of the penalty range, reached when quality of disclosure is 100%.", "type": "number", "minimum": 0, "maximum": 100 },
        "excuseQuestion": { "$ref": "#/$defs/rateKey" },
        "excuseValue": { "description": "Answer that means a reasonable excuse and no penalty.", "type": "string", "minLength": 1 },
        "telling": { "$ref": "#/$defs/tellingReduction" },
        "helping": { "$ref": "#/$defs/disclosureSlice" },
        "giving": { "$ref": "#/$defs/disclosureSlice" }
      }
    }
  }
}
