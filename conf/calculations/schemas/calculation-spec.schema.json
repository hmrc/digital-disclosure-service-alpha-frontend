{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hmrc.gov.uk/dds-alpha/calculations/calculation-spec.schema.json",
  "title": "DDS calculations prototype calculation spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "incomeComponents", "allowances", "tax"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "incomeComponents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/incomeComponent" }
    },
    "allowances": {
      "type": "array",
      "items": { "$ref": "#/$defs/allowance" }
    },
    "tax": { "$ref": "#/$defs/taxRules" }
  },
  "$defs": {
    "messageKey": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "rateKey": {
      "type": "string",
      "enum": [
        "personalAllowance",
        "taperThreshold",
        "blindPersonsAllowance",
        "basicRateBand",
        "basicRate",
        "higherRate"
      ]
    },
    "showIf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "equals": { "type": "string" },
        "contains": { "type": "string" },
        "notEquals": { "type": "string" }
      }
    },
    "incomeComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "$ref": "#/$defs/messageKey" },
        "kind": { "type": "string", "enum": ["amount", "net"] },
        "field": { "type": "string", "minLength": 1 },
        "grossField": { "type": "string", "minLength": 1 },
        "deductField": { "type": "string", "minLength": 1 },
        "altDeductField": { "type": "string", "minLength": 1 },
        "floorAtZero": { "type": "boolean" }
      }
    },
    "taper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thresholdRateKey", "reduceBy", "forEvery"],
      "properties": {
        "thresholdRateKey": { "$ref": "#/$defs/rateKey" },
        "reduceBy": { "type": "number", "exclusiveMinimum": 0 },
        "forEvery": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "allowance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "rateKey"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "$ref": "#/$defs/messageKey" },
        "kind": {
          "type": "string",
          "enum": ["personalAllowance", "conditionalAmount"]
        },
        "rateKey": { "$ref": "#/$defs/rateKey" },
        "taper": { "$ref": "#/$defs/taper" },
        "when": { "$ref": "#/$defs/showIf" }
      }
    },
    "taxBand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rateKey", "label"],
      "properties": {
        "rateKey": { "$ref": "#/$defs/rateKey" },
        "label": { "$ref": "#/$defs/messageKey" },
        "upToRateKey": { "$ref": "#/$defs/rateKey" }
      }
    },
    "taxRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bands"],
      "properties": {
        "bands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/taxBand" }
        },
        "scale": { "type": "integer", "minimum": 0, "maximum": 6 },
        "rounding": {
          "type": "string",
          "enum": ["halfUp", "up", "down", "floor", "ceiling"]
        }
      }
    }
  }
}
