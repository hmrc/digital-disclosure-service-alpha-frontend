# microservice specific routes

->         /hmrc-frontend           hmrcfrontend.Routes
GET        /                        uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.HelloWorldController.helloWorld
GET        /assets/*file            controllers.Assets.versioned(path = "/public", file: Asset)

# Upscan demo routes
GET        /upscan                  uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.UpscanController.demo

# Use case 1: User file upload
GET        /upscan/user-upload      uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.UpscanController.userUpload

# Use case 2: Service-generated file upload
GET        /upscan/generate-upload  uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.UpscanController.showGenerateForm
POST       /upscan/generate-upload  uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.UpscanController.submitGenerateForm

# Upload result and waiting pages
GET        /upscan/upload-result    uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.UpscanController.uploadResult
GET        /upscan/upload-error     uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.UpscanController.uploadError
GET        /upscan/upload-waiting/:reference   uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.UpscanController.uploadWaiting(reference: String)
GET        /upscan/upload-result/:reference    uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.UpscanController.uploadResultDirect(reference: String)
GET        /upscan/upload-status/:reference    uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.UpscanController.uploadStatus(reference: String)

# Upscan callback (no CSRF - called externally by upscan)
+ nocsrf
POST       /upscan/callback         uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.UpscanCallbackController.callback

# OPS payments demo routes (Start Payment Journey via pay-api)
GET        /payments/start          uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.PaymentsController.start
POST       /payments/start          uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.PaymentsController.startPayment
GET        /payments/return/:id     uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.PaymentsController.paymentReturn(id: String)

# NRS (Non-Repudiation Store) evidencing demo
GET        /nrs                     uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.NrsController.demo
GET        /nrs/start               uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.NrsController.start
POST       /nrs/submit              uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.NrsController.submit
GET        /nrs/result/:id          uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.NrsController.result(id: String)
POST       /nrs/retry/:id           uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.NrsController.retry(id: String)

# GOV.UK triage handoff PoC — stand-in for pre-login classifier → logged-in DDS
GET        /triage-poc                      uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.TriagePocController.demo
GET        /triage-poc/preauth              uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.TriagePocController.preauth
POST       /triage-poc/preauth              uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.TriagePocController.preauthSubmit
GET        /triage-poc/start                uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.TriagePocController.startDefault
GET        /triage-poc/start/ready          uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.TriagePocController.startReady
GET        /triage-poc/start/confirm        uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.TriagePocController.startConfirm
GET        /triage-poc/start/session        uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.TriagePocController.startSession
GET        /triage-poc/start/token          uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.TriagePocController.startToken
GET        /triage-poc/start/path/:exit     uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.TriagePocController.startPath(exit: String)
GET        /triage-poc/wrong-place          uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.TriagePocController.wrongPlace
POST       /triage-poc/routing              uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.TriagePocController.submitRouting
POST       /triage-poc/confirm              uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.TriagePocController.submitConfirm
POST       /triage-poc/accept-hint          uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.TriagePocController.acceptHint
GET        /triage-poc/result               uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.TriagePocController.result
GET        /triage-poc/:option/govuk        uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.TriagePocController.govuk(option: String)
POST       /triage-poc/:option/govuk        uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.TriagePocController.govukSubmit(option: String)
GET        /triage-poc/:option/govuk/done/:exit uk.gov.hmrc.digitaldisclosureservicealphafrontend.controllers.TriagePocController.govukDone(option: String, exit: String)
